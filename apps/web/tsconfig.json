{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "5.0",
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src"],
  // `sw.ts` needs the `webworker` lib, which TS cannot mix with the `DOM` lib
  // the rest of the app uses in one program (conflicting global declarations
  // like `Cache`/`Client`). See `tsconfig.sw.json` and `sw.ts`'s module doc.
  "exclude": ["src/sw.ts"],
  "references": [{ "path": "../../packages/shared" }]
}
