// Haushaltsauktion — Persistenzmodell
// Normative Quelle: .planning/architecture-haushaltsauktion.md §1.3
// Ergänzt um die Beschlüsse aus .planning/reconciliation-phase1-2.md §2.
//
// Was Prisma nicht ausdrücken kann (CHECK-Constraints, partielle Unique-Indizes,
// der entzogene UPDATE/DELETE-Grant auf dem Ledger) steht in
// prisma/migrations/20260830000100_constraints/migration.sql — Architektur §1.5.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────── enums ───────────────────────────────
// Strategie-Enums (Freikaufkosten, Wertsteigerung, Zuweisung, Reset, Rundung,
// Verfall) sind KEINE Prisma-Enums — sie leben in der Konfigurations-JSON und
// werden von Zod in packages/shared typisiert. Nur persistierte Spalten
// bekommen ein Prisma-Enum.

enum MemberRole {
  MEMBER
  ADMIN
}

enum TaskStatus {
  DRAFT
  AVAILABLE
  ASSIGNED
  COMPLETED
  CANCELLED
  PAUSED
  EXPIRED
}

enum AssignmentKind {
  VOLUNTARY
  RANDOM
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  BOUGHT_OUT
  RELEASED
  REVOKED
  EXPIRED
  REJECTED
}

enum AssignmentResponse {
  PENDING
  ACCEPTED
}

enum EligibilityMode {
  INCLUDED
  EXCLUDED
}

enum RecurrenceType {
  ONCE
  DAILY
  WEEKDAYS
  WEEKLY
  EVERY_N_DAYS
  MONTHLY
  MANUAL
}

/// Multi-worker-tasks (Phase 1, .planning/architecture-multi-worker-tasks.md).
/// How many ACTIVE slots a TaskInstance is meant to carry at once.
/// EXACTLY(n)/AT_LEAST(n) both require n; AT_MOST(n) still needs at least one
/// worker in the end (worker-slots.ts minRequired) — a task is never "done"
/// with zero workers.
enum WorkerCountMode {
  EXACTLY
  AT_LEAST
  AT_MOST
}

enum ActorType {
  MEMBER
  ADMIN
  SYSTEM
}

enum PointTransactionType {
  VOLUNTARY_TASK_REWARD
  BUYOUT
  MANUAL_ADJUSTMENT
  DECAY
  BONUS
  PENALTY
  CORRECTION
  /// Tages-Streak-Bonus (intake "daily-completion-streak-bonus"). Sign wie
  /// VOLUNTARY_TASK_REWARD: amount > 0 (ledger-math.ts signRuleViolated).
  STREAK_BONUS
  /// Punkte-Shop (intake "points-shop-real-life-rewards"). Sign wie BUYOUT:
  /// amount < 0 (ledger-math.ts signRuleViolated).
  REWARD_REDEMPTION
}

enum HistoryEventType {
  CREATED
  OFFERED
  VOLUNTEERED
  NO_VOLUNTEER
  RANDOMLY_ASSIGNED
  ASSIGNMENT_ACCEPTED
  CONSTRAINT_RELAXED
  NO_ELIGIBLE_CANDIDATES
  BOUGHT_OUT
  VALUE_INCREASED
  RE_OFFERED
  RELEASED
  REVOKED
  COMPLETED
  POINTS_AWARDED
  POINTS_CLAWED_BACK
  VALUE_RESET
  EXPIRED
  CANCELLED
  PAUSED
  RESUMED
  COMPLETION_REJECTED
  REOPENED_TO_ASSIGNEE
  STREAK_BONUS_AWARDED
}

enum NotificationType {
  TASK_AVAILABLE
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_VALUE_INCREASED
  TASK_COMPLETED
  ADMIN_NO_CANDIDATES

  /// §24 / Integrationen: die Todoist-Verbindung eines Mitglieds funktioniert
  /// nicht mehr, oder eine Aufgabe konnte nicht angelegt/entfernt werden.
  /// Stilles Dauerversagen wäre schlimmer als gar keine Integration: das
  /// Mitglied glaubt sonst, seine Aufgaben stünden in Todoist.
  INTEGRATION_FAILED

  /// D-07 (Todoist-Integrationsarchitektur): eine freiwillige Übernahme löste
  /// bislang keine Benachrichtigung aus. Bewusst kein Recycling von
  /// TASK_ASSIGNED — dessen "du wurdest zugelost"-Bedeutung wird in der UI
  /// vorausgesetzt.
  TASK_TAKEN
}

enum AuditAction {
  HOUSEHOLD_REGISTERED
  LOGIN_SUCCEEDED
  LOGIN_FAILED
  CONFIG_UPDATED
  MEMBER_CREATED
  MEMBER_UPDATED
  MEMBER_DEACTIVATED
  ROLE_CHANGED
  RESTRICTIONS_UPDATED
  POINTS_ADJUSTED
  LEDGER_CACHE_REPAIRED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  TASK_DEFINITION_CREATED
  TASK_DEFINITION_UPDATED
  TASK_DEFINITION_ARCHIVED
  TASK_DEFINITION_REACTIVATED
  INSTANCE_MATERIALIZED
  INSTANCE_PUBLISHED
  INSTANCE_CANCELLED
  INSTANCE_PAUSED
  INSTANCE_RESUMED
  INSTANCE_EXPIRED
  ASSIGNMENT_SWEEP_RUN
  RANDOM_SELECTION
  ASSIGNMENT_REVOKED
  BUYOUT_EXECUTED
  TASK_COMPLETED
  TASK_COMPLETION_REJECTED
  PASSWORD_RESET

  /// §23 / Integrationen. Payload trägt { provider, projectId?, triggers? } —
  /// NIE das Token und nie den tokenHint.
  INTEGRATION_CONNECTED
  INTEGRATION_DISCONNECTED
  INTEGRATION_SETTINGS_UPDATED

  /// Punkte-Shop (intake "points-shop-real-life-rewards").
  REWARD_DEFINITION_CREATED
  REWARD_DEFINITION_UPDATED
  REWARD_PURCHASED
  REWARD_FULFILLED

  /// Virtuelle Gamification-Items (intake "points-shop-virtual-gamification-items"):
  /// ein `VIRTUAL_EFFECT`-Kauf wurde sofort wirksam — kein Erfüllungsschritt,
  /// aber ein eigener Audit-Eintrag neben REWARD_PURCHASED, weil "wurde
  /// gekauft" und "wurde wirksam" hier derselbe Moment sind und beides sichtbar
  /// sein soll (§23).
  MEMBER_EFFECT_ACTIVATED
}

// ───────────────────────── identity plane ─────────────────────────
// §1.2: User und Session tragen bewusst KEINE householdId. §26 verlangt, dass
// eine Person perspektivisch Mitglied mehrerer Haushalte sein kann.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash") // argon2id, PRD §2
  displayName  String   @map("display_name")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  memberships HouseholdMember[]
  sessions    Session[]

  @@map("users")
}

model Session {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  tokenHash         String    @unique @map("token_hash") // sha256 des opaken Cookie-Werts
  csrfTokenHash     String    @map("csrf_token_hash") // Double-Submit-Partner, §3.1
  activeHouseholdId String?   @map("active_household_id") // nur Zeiger, pro Request neu autorisiert
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ───────────────────────── operator plane ─────────────────────────
// Betriebsdashboard (intake operator-dashboard-active-households-users-metrics,
// sharpened via /citadel:grill). Bewusst NICHT Teil der identity plane oben:
// "wie viele Haushalte gibt es" ist inhärent haushaltsübergreifend, und
// RequestContext (context.ts) ist strukturell an activeHouseholdId/householdId
// gebunden. Ein OperatorAccount ist deshalb eine vollständig eigenständige
// Identität — kein Feld, keine Relation, kein gemeinsames Cookie mit
// User/Session/HouseholdMember. Dieselbe argon2id-Hashing wie User
// (infra/auth/password.ts), aber eigene Tabellen, eigenes Cookie
// ("operator_session"), eigener Login-/Context-Pfad (operatorContext.ts).

model OperatorAccount {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash") // argon2id, wie User
  createdAt    DateTime @default(now()) @map("created_at")

  sessions OperatorSession[]

  @@map("operator_accounts")
}

model OperatorSession {
  id                String    @id @default(cuid())
  operatorAccountId String    @map("operator_account_id")
  tokenHash         String    @unique @map("token_hash") // sha256 des opaken Cookie-Werts
  csrfTokenHash     String    @map("csrf_token_hash") // Double-Submit-Partner, wie Session
  createdAt         DateTime  @default(now()) @map("created_at")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")

  operatorAccount OperatorAccount @relation(fields: [operatorAccountId], references: [id], onDelete: Cascade)

  @@index([operatorAccountId])
  @@index([expiresAt])
  @@map("operator_sessions")
}

// ───────────────────────── household plane ─────────────────────────

model Household {
  id        String   @id @default(cuid())
  name      String
  timezone  String   @default("Europe/Berlin") // §5.6 Wochenfenster, OQ-6
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  members        HouseholdMember[]
  configurations HouseholdConfiguration[]
  categories     TaskCategory[]
  definitions    TaskDefinition[]
  instances      TaskInstance[]
  assignments    TaskAssignment[]
  transactions   PointTransaction[]
  historyEvents  TaskHistoryEvent[]
  notifications  Notification[]
  auditEvents    AuditEvent[]

  memberIntegrations   MemberIntegration[]
  integrationOutbox    IntegrationOutbox[]
  integrationTaskLinks IntegrationTaskLink[]

  rewardDefinitions RewardDefinition[]
  rewardRedemptions RewardRedemption[]
  memberEffects     MemberEffect[]

  @@map("households")
}

model HouseholdMember {
  id          String     @id @default(cuid())
  householdId String     @map("household_id")
  userId      String     @map("user_id")
  displayName String     @map("display_name") // §3.1 — darf je Haushalt abweichen
  avatarUrl   String?    @map("avatar_url")
  role        MemberRole @default(MEMBER)
  isActive    Boolean    @default(true) @map("is_active") // §3.1 aktiv/inaktiv

  /// Abgeleiteter Cache des Ledgers. Wird NIE außerhalb von postTransaction
  /// (§8.2) geschrieben. Source of Truth ist das Ledger (§14, PRD §3G).
  pointsCache Int @default(0) @map("points_cache")

  /// §3.1 Teilnahmebeschränkung: Obergrenze zufälliger Zuweisungen pro Woche (§5.6).
  maxRandomAssignmentsPerWeek Int? @map("max_random_assignments_per_week")

  /// Tages-Streak (intake "daily-completion-streak-bonus"): Länge der
  /// laufenden Serie und der letzte Tag (Haushaltszeitzone, "YYYY-MM-DD",
  /// week.ts civilDateKey), an dem mindestens eine Erledigung zählte.
  /// bonusPaidDate hält fest, für welchen Tag bereits ein STREAK_BONUS
  /// gebucht wurde — höchstens einer pro Tag. NULL = keine aktive Serie /
  /// noch keine Buchung. Wird NIE außerhalb von completeTask / clawback /
  /// runStreakSweep geschrieben; jede Punktewirkung läuft weiterhin über das
  /// Ledger (§14, §44) — dies sind reine Zustandsfelder, keine Salden.
  streakLength         Int     @default(0) @map("streak_length")
  streakLastActiveDate String? @map("streak_last_active_date")
  streakBonusPaidDate  String? @map("streak_bonus_paid_date")

  joinedAt  DateTime @default(now()) @map("joined_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  household          Household                         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user               User                              @relation(fields: [userId], references: [id], onDelete: Restrict)
  absences           MemberAbsence[]
  categoryExclusions MemberCategoryExclusion[]
  taskEligibility    TaskDefinitionEligibility[]
  preferredForTasks  TaskDefinitionPreferredAssignee[]
  assignments        TaskAssignment[]
  transactions       PointTransaction[]                @relation("LedgerOwner")
  initiatedTx        PointTransaction[]                @relation("LedgerInitiator")
  historyEvents      TaskHistoryEvent[]
  notifications      Notification[]
  auditEvents        AuditEvent[]
  completedInstances TaskInstance[]                    @relation("CompletedBy")
  authoredConfigs    HouseholdConfiguration[]

  integrations         MemberIntegration[]
  integrationOutbox    IntegrationOutbox[]
  integrationTaskLinks IntegrationTaskLink[]

  rewardRedemptions    RewardRedemption[] @relation("RewardBuyer")
  fulfilledRedemptions RewardRedemption[] @relation("RewardFulfiller")
  effects              MemberEffect[]

  @@unique([householdId, userId])
  @@index([householdId, isActive])
  @@map("household_members")
}

/// §3.1 "vorübergehend nicht verfügbar" als Zeitfenster, nicht als Flag —
/// sonst bleibt jemand nach einem Urlaub für immer ausgeschlossen (§1.4).
model MemberAbsence {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  memberId    String   @map("member_id")
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")

  member HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([householdId, memberId, startsAt, endsAt])
  @@map("member_absences")
}

model TaskCategory {
  id          String   @id @default(cuid())
  householdId String   @map("household_id")
  name        String
  colorHex    String?  @map("color_hex")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  household   Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  definitions TaskDefinition[]
  exclusions  MemberCategoryExclusion[]

  @@unique([householdId, name])
  @@map("task_categories")
}

model MemberCategoryExclusion {
  householdId String   @map("household_id")
  memberId    String   @map("member_id")
  categoryId  String   @map("category_id")
  createdAt   DateTime @default(now()) @map("created_at")

  member   HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  category TaskCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([memberId, categoryId])
  @@index([householdId, categoryId])
  @@map("member_category_exclusions")
}

// ───────────────────────── configuration ─────────────────────────

/// Append-only. Die aktive Konfiguration ist MAX(version) je Haushalt.
/// Rollback = eine ältere Version als neue Version anhängen (§5.2).
model HouseholdConfiguration {
  id                String   @id @default(cuid())
  householdId       String   @map("household_id")
  version           Int
  values            Json // validiert durch HouseholdConfigSchema (§5.3)
  changeSummary     Json?    @map("change_summary") // strukturierter Diff gegen die Vorgängerversion
  createdAt         DateTime @default(now()) @map("created_at")
  createdByMemberId String?  @map("created_by_member_id")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy HouseholdMember? @relation(fields: [createdByMemberId], references: [id], onDelete: SetNull)

  instances   TaskInstance[]
  assignments TaskAssignment[]

  @@unique([householdId, version])
  @@index([householdId, version(sort: Desc)])
  @@map("household_configurations")
}

// ───────────────────────── tasks ─────────────────────────

/// Die wiederkehrende Vorlage "Bad putzen – jeden Samstag" (§27).
/// Sie besitzt baseValue und die Wiederholungsregel. Sie besitzt NIE currentValue.
model TaskDefinition {
  id          String  @id @default(cuid())
  householdId String  @map("household_id")
  title       String
  description String?
  categoryId  String? @map("category_id")

  /// §3.2 Basiswert. Das Reset-Ziel jeder Instanz dieser Definition.
  baseValue        Int     @map("base_value")
  estimatedMinutes Int?    @map("estimated_minutes")
  isActive         Boolean @default(true) @map("is_active") // §3.2 Aktivstatus
  buyoutEnabled    Boolean @default(true) @map("buyout_enabled") // §8 "Freikauf bei bestimmten Aufgaben deaktiviert"

  /// Multi-worker-tasks Phase 1: wie viele gleichzeitige ACTIVE-Zuweisungen eine
  /// Instanz dieser Definition tragen soll. Default EXACTLY(1) ⇒ heutiges
  /// Ein-Personen-Verhalten unverändert (worker-slots.ts).
  workerCountMode WorkerCountMode @default(EXACTLY) @map("worker_count_mode")
  workerCount     Int             @default(1) @map("worker_count")

  /// Rollenbasierte Berechtigung (intake
  /// "task-role-based-eligibility-and-preferred-assignee"): zusätzlich zu (nicht
  /// anstelle von) den personenbezogenen INCLUDED/EXCLUDED-Regeln in
  /// TaskDefinitionEligibility. null = kein Rollenfilter (Default, reproduziert
  /// heutiges Verhalten). Ausgewertet als zusätzliche harte Regel in
  /// eligibility.ts, gilt daher auch für freiwillige Übernahme.
  requiredRole MemberRole? @map("required_role")

  /// Multi-Worker-Mindestanzahl an Admin-Slots (dasselbe Intake): bei gesetztem
  /// Wert müssen mindestens N der belegten Slots einer Instanz dieser Definition
  /// von Admins gehalten werden. null = kein Minimum. Wirkt nur auf neue
  /// Zuweisungen (freiwillig und Zufallsvergabe, worker-slots.ts
  /// adminSlotReservationActive) — verdrängt nie bereits belegte
  /// Nicht-Admin-Slots.
  minAdminSlots Int? @map("min_admin_slots")

  // §18 Wiederholung — explizite Felder statt RRULE (§1.4).
  recurrenceType       RecurrenceType @default(ONCE) @map("recurrence_type")
  recurrenceInterval   Int?           @map("recurrence_interval") // N, für EVERY_N_DAYS
  recurrenceWeekdays   Int[]          @default([]) @map("recurrence_weekdays") // 1=Mo .. 7=So, für WEEKDAYS / WEEKLY
  recurrenceDayOfMonth Int?           @map("recurrence_day_of_month") // 1..28, für MONTHLY
  recurrenceTimeOfDay  String?        @map("recurrence_time_of_day") // "HH:mm" in der Haushaltszeitzone
  dueOffsetMinutes     Int?           @map("due_offset_minutes") // dueAt = occurrenceStart + offset

  /// §11 Übertrag der resetStrategy. null ⇒ die nächste Instanz startet bei baseValue.
  /// Nur unter KEEP_CURRENT / DECREASE_PERCENTAGE je gesetzt (§5.7, OQ-1).
  carriedValue Int? @map("carried_value")

  lastCompletedAt DateTime? @map("last_completed_at") // §3.2 letzte Erledigung
  nextDueAt       DateTime? @map("next_due_at") // §3.2 nächste Fälligkeit
  archivedAt      DateTime? @map("archived_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  household          Household                         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category           TaskCategory?                     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  eligibility        TaskDefinitionEligibility[]
  preferredAssignees TaskDefinitionPreferredAssignee[]
  instances          TaskInstance[]

  @@index([householdId, isActive, nextDueAt])
  @@map("task_definitions")
}

/// §3.2 "mögliche Personen" / "ausgeschlossene Personen" in einer Tabelle.
/// Existiert mindestens eine INCLUDED-Zeile, ist der Pool auf diese beschränkt.
/// EXCLUDED-Zeilen ziehen immer ab und gewinnen gegen INCLUDED (§6.9).
model TaskDefinitionEligibility {
  taskDefinitionId String          @map("task_definition_id")
  memberId         String          @map("member_id")
  householdId      String          @map("household_id")
  mode             EligibilityMode
  createdAt        DateTime        @default(now()) @map("created_at")

  definition TaskDefinition  @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  member     HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskDefinitionId, memberId])
  @@index([householdId, memberId])
  @@map("task_definition_eligibility")
}

/// Bevorzugte Zuweisung (intake
/// "task-role-based-eligibility-and-preferred-assignee"): weiche Präferenz, die
/// nur die Gewichtung bei WEIGHTED_FAIRNESS beeinflusst (weights.ts
/// preferredTerm) — blockiert nie eine freiwillige Übernahme durch jemand
/// anderen und schließt niemanden von der Zufallsvergabe aus. Bewusst getrennt
/// von TaskDefinitionEligibility: eine Person kann gleichzeitig "eingeschlossen"
/// (hart) UND "bevorzugt" (weich) sein, was ein gemeinsames mode-Feld nicht
/// abbilden könnte.
model TaskDefinitionPreferredAssignee {
  taskDefinitionId String   @map("task_definition_id")
  memberId         String   @map("member_id")
  householdId      String   @map("household_id")
  createdAt        DateTime @default(now()) @map("created_at")

  definition TaskDefinition  @relation(fields: [taskDefinitionId], references: [id], onDelete: Cascade)
  member     HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([taskDefinitionId, memberId])
  @@index([householdId, memberId])
  @@map("task_definition_preferred_assignees")
}

/// Eine konkrete Ausprägung: "Bad putzen – 29.08.2026" (§27).
/// currentValue lebt hier und nirgendwo sonst.
model TaskInstance {
  id               String @id @default(cuid())
  householdId      String @map("household_id")
  taskDefinitionId String @map("task_definition_id")

  status TaskStatus @default(DRAFT)

  /// §3.2 aktueller Wert. Steigt beim Freikauf, wird bei Erledigung zurückgesetzt (§11).
  currentValue Int @map("current_value")

  /// Beim Materialisieren aus TaskDefinition.baseValue kopiert, damit ein Admin
  /// mit einer Änderung an der Definition nicht das Reset-Ziel einer bereits
  /// laufenden Instanz verschiebt. Reine Anzeigefelder werden NICHT kopiert.
  baseValue Int @map("base_value")

  /// Multi-worker-tasks Phase 1: beim Materialisieren aus TaskDefinition
  /// kopiert, wie baseValue oben — dieselbe Begründung (§3.2, "Reset-Ziel einer
  /// laufenden Instanz"). activeSlotCount ist der denormalisierte Zähler
  /// ACTIVE-Zuweisungen dieser Instanz; in Phase 1 schreibt ihn niemand.
  workerCountMode WorkerCountMode @default(EXACTLY) @map("worker_count_mode")
  workerCount     Int             @default(1) @map("worker_count")
  activeSlotCount Int             @default(0) @map("active_slot_count")

  buyoutCount Int @default(0) @map("buyout_count") // §20 "bisherige Freikäufe"; auch Formelvariable

  scheduledFor        DateTime  @map("scheduled_for") // die Ausprägung, die diese Instanz repräsentiert
  dueAt               DateTime? @map("due_at") // §3.2 optionale Fälligkeit
  offerExpiresAt      DateTime? @map("offer_expires_at") // §6 — ab wann der Zufallslauf zugreifen darf
  publishedAt         DateTime? @map("published_at")
  completedAt         DateTime? @map("completed_at")
  completedByMemberId String?   @map("completed_by_member_id")
  closedAt            DateTime? @map("closed_at") // gesetzt für COMPLETED / CANCELLED / EXPIRED

  /// Bei der Veröffentlichung fixierte Konfiguration. Bestimmt Angebotsdauer und
  /// Reset-Strategie, solange keine Zuweisung existiert. Auflösungsregel: §5.5.
  configVersion Int @map("config_version")

  /// Compare-and-Set-Token. Steigt bei JEDER Status- oder Wertänderung (§4.3).
  /// Dient gleichzeitig als ETag für die Erkennung veralteter Ansichten.
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  household   Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  definition  TaskDefinition         @relation(fields: [taskDefinitionId], references: [id], onDelete: Restrict)
  completedBy HouseholdMember?       @relation("CompletedBy", fields: [completedByMemberId], references: [id], onDelete: SetNull)
  config      HouseholdConfiguration @relation(fields: [householdId, configVersion], references: [householdId, version], onDelete: Restrict)

  assignments   TaskAssignment[]
  historyEvents TaskHistoryEvent[]
  transactions  PointTransaction[]
  notifications Notification[]

  integrationOutbox    IntegrationOutbox[]
  integrationTaskLinks IntegrationTaskLink[]

  @@index([householdId, status, offerExpiresAt])
  @@index([householdId, status, dueAt])
  @@index([taskDefinitionId, status])
  @@map("task_instances")
}

/// Ein angenommenes oder auferlegtes Angebot. Je Instanz-Slot höchstens EINE
/// ACTIVE — erzwungen durch den Sentinel activeSlotKey (§1.5, Multi-worker-
/// tasks Phase 2).
model TaskAssignment {
  id             String @id @default(cuid())
  householdId    String @map("household_id")
  taskInstanceId String @map("task_instance_id")
  memberId       String @map("member_id")

  kind     AssignmentKind
  status   AssignmentStatus   @default(ACTIVE)
  response AssignmentResponse @default(PENDING) // §21 "Aufgabe übernehmen", OQ-3

  /// Alter Sentinel, VOR Multi-worker-tasks: gleich taskInstanceId, solange
  /// ACTIVE; NULL nach dem Schließen; UNIQUE ⇒ eine zweite gleichzeitige
  /// Zuweisung war ein 23505.
  ///
  /// Multi-worker-tasks Phase 2: activeSlotKey hat diese Rolle übernommen.
  /// Dieses Feld wird nur noch vom slotIndex-0-Halter einer Instanz gesetzt
  /// (die einzige Zeile, für die "gleich taskInstanceId" noch eindeutig ist,
  /// da jede Instanz höchstens einen Slot 0 hat) — für EXACTLY(1), also jede
  /// bestehende Aufgabe, ist das immer die einzige ACTIVE-Zuweisung, also
  /// unverändertes Verhalten. Migration 20260904060000 hat den CHECK
  /// "(status = ACTIVE) = (active_for_instance_id IS NOT NULL)" gelockert zu
  /// "active_for_instance_id IS NULL OR (status = ACTIVE AND ... = taskInstanceId)",
  /// weil die alte Fassung eine zweite gleichzeitig ACTIVE Zuweisung auf
  /// DERSELBEN Instanz (andere slotIndex) strukturell unmöglich machte, egal
  /// was hier geschrieben wird — das genau war der Zweck von activeSlotKey.
  /// Zwei App-Dateien (reopen.ts, rejectCompletion.ts) lesen/schreiben es
  /// weiterhin unverändert; siehe HANDOFF für die Begründung, warum das für
  /// diese Phase ausreicht.
  activeForInstanceId String? @unique @map("active_for_instance_id")

  /// Multi-worker-tasks Phase 1: welcher der workerCount-vielen Plätze diese
  /// Zuweisung belegt. 0 für alle bestehenden Zeilen (heutiges
  /// Ein-Personen-Verhalten hatte nur Platz 0).
  slotIndex Int @default(0) @map("slot_index")

  /// Der künftige Sentinel: `${taskInstanceId}:${slotIndex}`, solange ACTIVE;
  /// NULL nach dem Schließen. UNIQUE macht eine doppelte Belegung DESSELBEN
  /// Slots zu einem 23505 — anders als activeForInstanceId erlaubt er mehrere
  /// gleichzeitig ACTIVE Zuweisungen je Instanz, solange die Slots verschieden
  /// sind. Wird in Phase 1 von keiner Use-Case-Zeile geschrieben.
  activeSlotKey String? @unique @map("active_slot_key")

  /// Der currentValue der Instanz im Moment der Zuweisung — also genau die Zahl,
  /// die dem Mitglied angezeigt wurde. Basis der Quote-Drift-Erkennung.
  valueAtAssignment Int @map("value_at_assignment")

  /// Bei der Zuweisung fixierte Konfiguration (PRD §6). Bestimmt Freikaufkosten,
  /// Wertsteigerung, Belohnungsmultiplikator und Reset-Strategie DIESER Zuweisung.
  configVersion Int @map("config_version")

  /// Nur für kind = RANDOM. Speist GET /assignments/:id/explain (§32).
  /// Form: SelectionTrace (§6.10). Enthält nie die rohe Zufallszahl.
  selectionTrace Json? @map("selection_trace")

  // Ergebnis des Freikaufs. CHECK erzwingt valueAfterBuyout > valueBeforeBuyout (§1.5).
  buyoutCost        Int? @map("buyout_cost")
  valueBeforeBuyout Int? @map("value_before_buyout")
  valueAfterBuyout  Int? @map("value_after_buyout")

  assignedAt  DateTime  @default(now()) @map("assigned_at")
  respondedAt DateTime? @map("responded_at")
  completedAt DateTime? @map("completed_at")
  closedAt    DateTime? @map("closed_at")

  household Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  instance  TaskInstance           @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  member    HouseholdMember        @relation(fields: [memberId], references: [id], onDelete: Restrict)
  config    HouseholdConfiguration @relation(fields: [householdId, configVersion], references: [householdId, version], onDelete: Restrict)

  transactions  PointTransaction[]
  historyEvents TaskHistoryEvent[]

  /// Ziel des zusammengesetzten Fremdschlüssels von PointTransaction. Macht es
  /// strukturell unmöglich, eine VOLUNTARY_TASK_REWARD an eine RANDOM-Zuweisung
  /// zu hängen (§1.5, §44).
  @@unique([id, kind])
  @@index([householdId, memberId, status])
  @@index([taskInstanceId, status])
  @@index([householdId, kind, assignedAt])
  @@map("task_assignments")
}

// ───────────────────────── ledger ─────────────────────────

/// Append-only. Source of Truth für jeden Punktestand (§14, PRD §3G).
/// Die Laufzeit-Datenbankrolle besitzt kein UPDATE/DELETE auf dieser Tabelle (§8.6).
model PointTransaction {
  id String @id @default(cuid())

  /// Globale monotone Reihenfolge. createdAt kann kollidieren, seq nicht.
  seq         BigInt @default(autoincrement())
  householdId String @map("household_id")
  memberId    String @map("member_id")

  amount        Int // vorzeichenbehaftet; Vorzeichenregeln je Typ als CHECK (§1.5)
  balanceBefore Int @map("balance_before")
  balanceAfter  Int @map("balance_after") // CHECK (balanceAfter = balanceBefore + amount)

  type PointTransactionType

  /// Hash-Chain-lite. 'GENESIS' für den ersten Eintrag eines Mitglieds, sonst die
  /// id des Vorgängers. UNIQUE(memberId, previousTransactionId) macht ein Forken
  /// der Kette unmöglich, selbst wenn ein Row-Lock verloren ginge (§8.3).
  previousTransactionId String @map("previous_transaction_id")

  /// Deduplizierung wiederholter Schreibversuche: 'reward:<assignmentId>',
  /// 'buyout:<assignmentId>', 'clawback:<assignmentId>', 'decay:<memberId>:<periodKey>'.
  idempotencyKey String? @unique @map("idempotency_key")

  taskInstanceId   String? @map("task_instance_id")
  taskAssignmentId String? @map("task_assignment_id")

  /// Aus TaskAssignment.kind denormalisiert und über den zusammengesetzten
  /// Fremdschlüssel daran gebunden, damit ein CHECK Belohnungen auf
  /// Zufallszuweisungen verbieten kann (§1.5, §44).
  assignmentKind AssignmentKind? @map("assignment_kind")

  /// Punkte-Shop (intake "points-shop-real-life-rewards"): gesetzt genau dann,
  /// wenn type = REWARD_REDEMPTION (CHECK in der Constraints-Migration) — ein
  /// eigenständiges Fremdschlüsselfeld statt einer Wiederverwendung von
  /// taskAssignmentId, weil eine Einlösung keine TaskAssignment-Zeile ist.
  rewardRedemptionId String? @map("reward_redemption_id")

  description       String?
  initiatorMemberId String?   @map("initiator_member_id") // null ⇒ SYSTEM (§14 "Initiator")
  initiatorType     ActorType @default(MEMBER) @map("initiator_type")
  createdAt         DateTime  @default(now()) @map("created_at")

  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member           HouseholdMember   @relation("LedgerOwner", fields: [memberId], references: [id], onDelete: Restrict)
  initiator        HouseholdMember?  @relation("LedgerInitiator", fields: [initiatorMemberId], references: [id], onDelete: SetNull)
  instance         TaskInstance?     @relation(fields: [taskInstanceId], references: [id], onDelete: Restrict)
  assignment       TaskAssignment?   @relation(fields: [taskAssignmentId, assignmentKind], references: [id, kind], onDelete: Restrict)
  rewardRedemption RewardRedemption? @relation(fields: [rewardRedemptionId], references: [id], onDelete: Restrict)

  @@unique([memberId, previousTransactionId])
  @@index([householdId, memberId, seq])
  @@index([householdId, createdAt])
  @@index([taskAssignmentId])
  @@index([rewardRedemptionId])
  @@map("point_transactions")
}

// ───────────────────── history, notifications, audit ─────────────────────

/// Die mitgliederseitige Zeitleiste aus §22. Strukturiert, nicht als Fließtext.
model TaskHistoryEvent {
  id             String           @id @default(cuid())
  seq            BigInt           @default(autoincrement())
  householdId    String           @map("household_id")
  taskInstanceId String           @map("task_instance_id")
  assignmentId   String?          @map("assignment_id")
  memberId       String?          @map("member_id")
  type           HistoryEventType

  /// Typisiert je Ereignisart — siehe die Payload-Tabelle in §2.5.
  payload   Json
  createdAt DateTime @default(now()) @map("created_at")

  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  instance   TaskInstance     @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)
  assignment TaskAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  member     HouseholdMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([householdId, seq])
  @@index([taskInstanceId, seq])
  @@map("task_history_events")
}

model Notification {
  id             String           @id @default(cuid())
  householdId    String           @map("household_id")
  memberId       String           @map("member_id")
  type           NotificationType
  payload        Json
  taskInstanceId String?          @map("task_instance_id")
  readAt         DateTime?        @map("read_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  instance  TaskInstance?   @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)

  @@index([householdId, memberId, readAt, createdAt])
  @@map("notifications")
}

/// §23. Admin- und systemseitig. Getrennt von TaskHistoryEvent, das ein
/// Familienmitglied liest. Append-only; kein DELETE-Grant zur Laufzeit (§8.6).
model AuditEvent {
  id            String      @id @default(cuid())
  seq           BigInt      @default(autoincrement())
  householdId   String      @map("household_id")
  actorType     ActorType   @map("actor_type")
  actorMemberId String?     @map("actor_member_id")
  action        AuditAction
  entityType    String      @map("entity_type")
  entityId      String?     @map("entity_id")

  /// { before?, after?, diff?, reason?, ... } — für RANDOM_SELECTION siehe §6.10.
  payload   Json
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  household Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  actor     HouseholdMember? @relation(fields: [actorMemberId], references: [id], onDelete: SetNull)

  @@index([householdId, seq])
  @@index([householdId, action, createdAt])
  @@index([householdId, entityType, entityId])
  @@map("audit_events")
}

// ───────────────────────── integrations (Todoist) ─────────────────────────
// Architektur: .planning/architecture-todoist-integration.md (r9).
//
// Die Integration ist NIVEAUGESTEUERT (level-triggered): ein Hintergrund-
// Reconciler vergleicht Soll (TaskAssignment mit status=ACTIVE, §6) gegen Ist
// (offene IntegrationTaskLink-Zeilen) und handelt auf der Differenz. Sie
// beobachtet KEINE Ereignisse und schreibt in KEINER Kerntransaktion — deshalb
// kann ein Todoist-Ausfall §28 (Atomarität von Übernahme/Freikauf/Erledigung)
// nicht verletzen. Kein Use-Case wurde für diese Integration verändert.

enum IntegrationProvider {
  TODOIST
}

enum IntegrationStatus {
  ACTIVE
  /// Todoist antwortete 401/403. Entzieht der Verbindung die Lebensfähigkeit
  /// (§6 Bedingung 4), womit das Soll entfällt — Unterdrückung kommt aus der
  /// URSACHE, nicht aus einer Endzustandszeile.
  INVALID_CREDENTIALS
  /// Mitglied hat getrennt. Zeile bleibt (Fremdschlüssel!), Geheimnis ist weg.
  DISABLED
}

/// ORPHANED ist der EINZIGE absorbierende Endzustand: der CREATE war bei
/// Todoist erfolgreich, aber die zurückgegebene ID ist unwiederbringlich
/// verloren. Ein erneuter Vorschlag könnte nichts reparieren, sondern nur ein
/// Duplikat erzeugen — die Ursache ist unumkehrbar. Alle anderen Endzustände
/// dürfen NICHT absorbieren (das war der Fehler von Revision r4).
enum OutboxStatus {
  PENDING
  SENT
  FAILED
  DEAD
  SKIPPED
  ORPHANED
}

enum OutboxOperation {
  CREATE_TASK
  CLOSE_TASK
}

/// Die Zugangsdaten, pro HouseholdMember (NICHT pro User): jede
/// Autorisierungsregel dieses Codebase stützt sich darauf, dass jede Zeile eine
/// householdId trägt (§36); User und Session tragen bewusst keine (§1.2).
/// Preis: wer in zwei Haushalten ist, verbindet zweimal.
model MemberIntegration {
  id          String              @id @default(cuid())
  householdId String              @map("household_id")
  memberId    String              @map("member_id")
  provider    IntegrationProvider
  status      IntegrationStatus   @default(ACTIVE)

  /// AES-256-GCM. Nie geloggt, nie serialisiert, von keiner Route zurückgegeben.
  /// NULL nach dem Trennen: das Geheimnis verschwindet, die Zeile bleibt.
  /// Umkehrbare Verschlüsselung, KEIN Hash — anders als User.passwordHash muss
  /// dieses Geheimnis wortgleich an Todoist zurückgespielt werden.
  tokenCiphertext Bytes?  @map("token_ciphertext")
  tokenIv         Bytes?  @map("token_iv")
  tokenAuthTag    Bytes?  @map("token_auth_tag")
  tokenKeyVersion Int?    @map("token_key_version")
  /// Letzte 4 Zeichen, Klartext. Damit die UI "…a3f9" zeigen kann, ohne zu
  /// entschlüsseln.
  tokenHint       String? @map("token_hint")

  /// Opake v1-ID: String, nicht Int. NULL = Todoist-Inbox.
  projectId   String? @map("project_id")
  projectName String? @map("project_name")

  /// Schlüssel sind EXAKT die AssignmentKind-Werte: VOLUNTARY und RANDOM,
  /// GROSSGESCHRIEBEN. Der Reconciler indiziert mit triggers[assignment.kind];
  /// kleingeschriebene Schlüssel ergäben `undefined` → falsy → NICHTS wäre je
  /// gewünscht und die Integration täte stillschweigend gar nichts.
  triggers Json @default("{\"VOLUNTARY\":true,\"RANDOM\":true}")

  lastSuccessAt DateTime? @map("last_success_at")
  lastErrorAt   DateTime? @map("last_error_at")
  lastErrorCode String?   @map("last_error_code")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  household Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member    HouseholdMember       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  outbox    IntegrationOutbox[]
  links     IntegrationTaskLink[]

  /// householdId führt bewusst: eslint-rules/index.js akzeptiert einen
  /// zusammengesetzten Schlüssel nur, wenn sein Name mit householdId_ beginnt.
  @@unique([householdId, memberId, provider])
  @@index([householdId, status])
  @@map("member_integrations")
}

/// Die Warteschlange. Zeilen entstehen AUSSCHLIESSLICH im Reconciler, nie in
/// einer Kerntransaktion.
model IntegrationOutbox {
  /// UUID statt cuid: diese ID wird wortgleich als Todoist-Sync-Command-`uuid`
  /// übertragen und liefert damit Exactly-once-Zustellung.
  id String @id @default(uuid())

  householdId   String @map("household_id")
  memberId      String @map("member_id")
  integrationId String @map("integration_id")

  operation OutboxOperation
  status    OutboxStatus    @default(PENDING)

  taskInstanceId String @map("task_instance_id")
  assignmentId   String @map("assignment_id")

  /// "todoist:{integrationId}:create:{assignmentId}" bzw. ":close:".
  /// Vorbild: PointTransaction.idempotencyKey. KEIN globales @@unique —
  /// stattdessen ein PARTIELLER Unique-Index nur über PENDING/FAILED
  /// (siehe Migration). Ein globales Unique würde Endzustandszeilen den
  /// Schlüssel dauerhaft belegen lassen und damit die Selbstheilung zerstören.
  enqueueKey String @map("enqueue_key")

  payload Json

  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  lastErrorCode String?  @map("last_error_code")
  /// Gekürzt. Enthält NIE das Token.
  lastErrorBody String?  @map("last_error_body")

  /// Doppelt genutzt, bewusst: bei CREATE_TASK NULL bis zum Erfolg, dann die
  /// von Todoist gelieferte ID; bei CLOSE_TASK beim Einreihen aus
  /// IntegrationTaskLink kopiert, also von Anfang an gesetzt. Deshalb nullable,
  /// obwohl IntegrationTaskLink.externalTaskId NOT NULL ist.
  externalTaskId String? @map("external_task_id")

  createdAt        DateTime  @default(now()) @map("created_at")
  /// Übergang in einen Endzustand (SENT/DEAD/SKIPPED/ORPHANED). Trägt die
  /// Sperrfrist (1 h) und das Deckel-Fenster (24 h).
  settledAt        DateTime? @map("settled_at")
  /// Gibt dem zustandslosen 60-s-Reconciler ein Gedächtnis pro Schlüssel:
  /// `notifications` besitzt keinen Dedup-Schlüssel, also wäre "genau eine
  /// Benachrichtigung" sonst nur behauptet und nicht mechanisiert.
  memberNotifiedAt DateTime? @map("member_notified_at")

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member      HouseholdMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  integration MemberIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  instance    TaskInstance      @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)

  /// Trägt den Anspruch des Dispatchers UND die In-Flight- sowie die
  /// ORPHANED-Abfrage des Reconcilers: das Präfix (household_id, status) genügt
  /// für alle drei.
  @@index([householdId, status, nextAttemptAt])
  /// Trägt die Sperrfrist- und Deckel-Abfrage (über settled_at prädiziert).
  @@index([householdId, settledAt])
  @@index([integrationId])
  @@index([taskInstanceId])
  @@map("integration_outbox")
}

/// Der dauerhafte Ist-Zustand: welche Todoist-Aufgabe zu welcher Zuweisung
/// gehört. Wird NIE geprunt und ist die Autorität für "existiert schon".
model IntegrationTaskLink {
  id             String @id @default(cuid())
  householdId    String @map("household_id")
  memberId       String @map("member_id")
  integrationId  String @map("integration_id")
  taskInstanceId String @map("task_instance_id")

  /// Der Schlüssel ist die ZUWEISUNG, nicht die Instanz: nach einem Freikauf
  /// wird dieselbe Instanz erneut angeboten und kann derselben Person erneut
  /// zufallen — als NEUE TaskAssignment-Zeile. Ein Instanz-Schlüssel würde den
  /// zweiten Durchlauf dauerhaft blockieren.
  assignmentId String @map("assignment_id")

  /// NOT NULL. Eine Verknüpfung entsteht ausschliesslich NACH einem bestätigten
  /// CREATE mit bekannter Todoist-ID. Damit trägt jedes CLOSE garantiert eine
  /// ID — und es gibt keine "unbestätigten" Zeilen, die ein Reparatursubsystem
  /// bräuchten.
  externalTaskId String @map("external_task_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  closedAt    DateTime? @map("closed_at")
  /// RECONCILED (normal) | DISCONNECTED (Trennung).
  closeReason String?   @map("close_reason")

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member      HouseholdMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  integration MemberIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  instance    TaskInstance      @relation(fields: [taskInstanceId], references: [id], onDelete: Cascade)

  @@unique([householdId, assignmentId])
  @@index([taskInstanceId])
  @@map("integration_task_links")
}

// ───────────────────────── rewards (Punkte-Shop) ─────────────────────────
// intake "points-shop-real-life-rewards": reale Belohnungen gegen Punkte,
// adminseitig verwaltet und erfüllt — ein Antrags-/Freigabe-Workflow über dem
// bestehenden Ledger, kein neuer Mechanismus für die Punktebuchung selbst.

enum RewardRedemptionStatus {
  PENDING
  FULFILLED
}

/// intake "points-shop-virtual-gamification-items": ein Katalogeintrag ist
/// entweder eine reale Belohnung (adminseitig erfüllt) oder ein virtueller
/// Effekt (sofort bei Kauf wirksam, kein Erfüllungsschritt). Der Kauf- und
/// Ledger-Mechanismus ist für beide identisch — nur was nach dem Debit
/// passiert, unterscheidet sich (`purchaseReward.ts`).
enum RewardKind {
  MANUAL_FULFILLMENT
  VIRTUAL_EFFECT
}

/// Die beiden Trank-Typen aus der Spezifikation. Neue Effekte brauchen nur
/// einen neuen Wert hier plus Auswertungslogik an der einen Stelle, die ihn
/// konsultiert (`eligibility.ts` für IMMUNITY, `completeTask.ts` für
/// MULTIPLIER) — kein neuer Katalog-Mechanismus.
enum EffectType {
  IMMUNITY
  MULTIPLIER
}

/// Der Katalogeintrag — parallel zu TaskDefinition (§27), aber ohne
/// Wiederholung oder Wert-Lebenszyklus: eine Belohnung hat einen festen Preis,
/// den ein Admin direkt pflegt, nicht einen currentValue, der durch Freikäufe
/// steigt.
///
/// Die vier `effect*`-Felder sind ausschließlich für `kind = VIRTUAL_EFFECT`
/// gesetzt — für `MANUAL_FULFILLMENT` bleiben sie NULL. Welche der drei
/// Effektparameter zusätzlich zu `effectType` Pflicht sind, hängt vom
/// `EffectType` ab (IMMUNITY nur Dauer; MULTIPLIER Dauer + Ladungen +
/// Multiplikator) — das prüft server-seitig `RewardBody` in `admin.ts`
/// (§36: keine client-vertraute Geschäftsregel).
model RewardDefinition {
  id          String     @id @default(cuid())
  householdId String     @map("household_id")
  title       String
  description String?
  cost        Int
  kind        RewardKind @default(MANUAL_FULFILLMENT) @map("kind")
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  effectType            EffectType? @map("effect_type")
  effectDurationMinutes Int?        @map("effect_duration_minutes")
  effectCharges         Int?        @map("effect_charges")
  effectMultiplier      Float?      @map("effect_multiplier")

  household   Household          @relation(fields: [householdId], references: [id], onDelete: Cascade)
  redemptions RewardRedemption[]

  @@index([householdId, isActive])
  @@map("reward_definitions")
}

/// Ein Kauf. costAtPurchase friert den Preis zum Kaufzeitpunkt ein — Vorbild
/// TaskAssignment.valueAtAssignment (§1.3) — damit eine spätere Preisänderung
/// am Katalogeintrag nie rückwirkend für eine schon laufende Einlösung gilt.
model RewardRedemption {
  id                 String @id @default(cuid())
  householdId        String @map("household_id")
  rewardDefinitionId String @map("reward_definition_id")
  memberId           String @map("member_id")

  costAtPurchase Int                    @map("cost_at_purchase")
  status         RewardRedemptionStatus @default(PENDING)

  purchasedAt         DateTime  @default(now()) @map("purchased_at")
  fulfilledAt         DateTime? @map("fulfilled_at")
  fulfilledByMemberId String?   @map("fulfilled_by_member_id")

  household   Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  reward      RewardDefinition @relation(fields: [rewardDefinitionId], references: [id], onDelete: Restrict)
  member      HouseholdMember  @relation("RewardBuyer", fields: [memberId], references: [id], onDelete: Restrict)
  fulfilledBy HouseholdMember? @relation("RewardFulfiller", fields: [fulfilledByMemberId], references: [id], onDelete: SetNull)

  transactions PointTransaction[]
  /// intake "points-shop-virtual-gamification-items": genau eine Zeile, wenn
  /// diese Einlösung ein `VIRTUAL_EFFECT`-Kauf war — angelegt in derselben
  /// Transaktion wie die Einlösung selbst (`purchaseReward.ts`); sonst leer.
  effects      MemberEffect[]

  @@index([householdId, status, purchasedAt])
  @@index([rewardDefinitionId])
  @@map("reward_redemptions")
}

/// intake "points-shop-virtual-gamification-items": das generische
/// "aktiver Mitgliedseffekt"-Substrat, statt zwei ad-hoc-Tabellen für
/// Immunität und Multiplikator. "Aktiv" bedeutet `expiresAt > now`, und für
/// MULTIPLIER zusätzlich `chargesRemaining > 0` — nirgendwo sonst ein Status-
/// Enum, damit Ablauf allein aus Zeit und Ladungen folgt.
///
/// `multiplierValue`/`chargesRemaining` sind nur für `type = MULTIPLIER`
/// gesetzt; für IMMUNITY bleiben beide NULL — `expiresAt` allein trägt die
/// gesamte Bedeutung dieses Effekts (Regel 8, `eligibility.ts`).
///
/// Wird ausschließlich innerhalb einer Transaktion geschrieben, die bereits
/// das Level-3-Lock auf `memberId` hält (§4.2) — beim Kauf
/// (`purchaseReward.ts`) und beim Verbrauch einer Ladung (`completeTask.ts`).
/// Kein eigenes Lock-Level: Schreibzugriffe reiten auf dem Member-Lock, das
/// der Aufrufer bereits hält.
model MemberEffect {
  id                 String     @id @default(cuid())
  householdId        String     @map("household_id")
  memberId           String     @map("member_id")
  type               EffectType
  rewardRedemptionId String     @map("reward_redemption_id")

  /// MULTIPLIER only.
  multiplierValue  Float? @map("multiplier_value")
  /// MULTIPLIER only. Sinkt atomar je qualifizierender freiwilliger Erledigung.
  chargesRemaining Int?   @map("charges_remaining")

  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  /// Gesetzt, sobald chargesRemaining 0 erreicht — reine Beobachtbarkeit,
  /// "aktiv" bleibt weiterhin über expiresAt/chargesRemaining definiert.
  consumedAt DateTime? @map("consumed_at")

  household  Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  member     HouseholdMember  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  redemption RewardRedemption @relation(fields: [rewardRedemptionId], references: [id], onDelete: Restrict)

  /// Trägt sowohl die IMMUNITY-Abfrage in `candidates.ts` (householdId, type,
  /// expiresAt) als auch die MULTIPLIER-Abfrage in `completeTask.ts`
  /// (householdId, memberId, type, expiresAt, chargesRemaining).
  @@index([householdId, memberId, type, expiresAt])
  @@map("member_effects")
}
