# Kopieren nach .env fuer den lokalen Start:  cp .env.example .env
# Diese Datei enthaelt nur Platzhalter und wird eingecheckt.
# Die echte .env ist in .gitignore und darf niemals committet werden.

POSTGRES_USER=haushalt
POSTGRES_PASSWORD=haushalt
POSTGRES_DB=haushaltsauktion
DB_PORT=5432

# Verbindung fuer lokale Entwicklung ausserhalb von Docker
DATABASE_URL=postgresql://haushalt:haushalt@localhost:5432/haushaltsauktion

# Signierung der Session-Cookies. In Produktion zwingend ersetzen.
SESSION_SECRET=dev-only-change-me

API_PORT=3000
WEB_PORT=8080
NODE_ENV=development
